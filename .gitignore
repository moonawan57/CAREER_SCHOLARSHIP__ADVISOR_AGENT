# Root .gitignore for the full-stack project

# ─── OS ───
.DS_Store
Thumbs.db
Desktop.ini

# ─── IDE / Editor ───
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Environment / Secrets ───
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env.local
frontend/.env.production

# ─── Certificates & Keys ───
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*-credentials.json

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
venv/
.venv/
ENV/
env/

# ─── SQLite ───
*.db
*.sqlite
*.sqlite3

# ─── Node.js / Next.js ───
node_modules/
.next/
out/
.turbopack/
dist-prod/

# ─── Build artifacts ───
frontend/dist/
frontend/dist-prod/

# ─── Logs & Tunnel artifacts ───
cloudflared*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc ───
.vercel
*.tsbuildinfo
next-env.d.ts