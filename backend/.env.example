# LLM provider: "gemini" or "groq" (defaults to groq)
LLM_PROVIDER=gemini

# Gemini API keys (primary and secondary for fallback when one key is rate-limited)
# Get yours from https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_MODEL=gemini/gemini-3.6-flash

# Groq API key (fallback when both Gemini keys fail)
# Get yours from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_MODEL=groq/openai/gpt-oss-120b

# Hugging Face Inference API (tertiary fallback)
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
HF_TOKEN_2=your_huggingface_token_2_here
HF_TOKEN_3=your_huggingface_token_3_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Logging level: DEBUG, INFO, WARNING, ERROR (production default: WARNING)
LOG_LEVEL=INFO

# Demo mode: when true, the backend skips the LLM and returns keyword-based responses.
DEMO_MODE=false
